{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "ATM Locations: What Happened Between 2017 and 2026",
  "width": "container",
  "height": 500,
  "params": [
    {
      "name": "stateSel",
      "value": "All"
    }
  ],
  "projection": {
    "type": "mercator",
    "center": {
      "expr": "[[134,-27],[149.05,-35.5],[147,-32.8],[133.5,-19],[145,-20],[134.5,-32],[146.5,-42.2],[145.5,-37],[121,-25]][indexof(['All','ACT','NSW','NT','QLD','SA','TAS','VIC','WA'], stateSel)]"
    },
    "scale": {
      "expr": "[700,30000,2280,1680,1320,1920,6600,3360,1200][indexof(['All','ACT','NSW','NT','QLD','SA','TAS','VIC','WA'], stateSel)]"
    }
  },
  "layer": [
    {
      "data": {
        "url": "STE_2021_AUST_GDA2020.json",
        "format": {"type": "topojson", "feature": "STE_2021_AUST_GDA2020"}
      },
      "mark": {"type": "geoshape", "fill": "#FFFFF0", "stroke": "black"}
    },
    {
      "data": {"url": "atm_change.csv"},
      "transform": [
  {"filter": "stateSel === 'All' || datum['States and Territories'] === stateSel"},
  {"calculate": "random()", "as": "shuffle"}
],
      "mark": {"type": "circle", "opacity": 1, "size": 30},
      "encoding": {
        "longitude": {"field": "Longitude", "type": "quantitative"},
        "latitude": {"field": "Latitude", "type": "quantitative"},
        "color": {
          "field": "status",
          "type": "nominal",
          "scale": {
            "domain": ["Still open", "Closed", "New"],
            "range": ["#000080", "red", "green"]
          },
          "legend": {"title": "2017 to 2026"}
        },
        "order": {"field": "shuffle", "type": "quantitative"},
        "tooltip": [
          {"field": "Suburb or locality", "title": "Suburb"},
          {"field": "Institution Name", "title": "Institution"},
          {"field": "n2017", "title": "ATMs in 2017"},
          {"field": "n2026", "title": "ATMs in 2026"},
          {"field": "status", "title": "Status"}
        ]
      }
    },
    {
  "data": { "values": [{}] },
  "mark": {
    "type": "text",
    "x": 10,
    "y": 10,
    "align": "left",
    "baseline": "top",
    "fontSize": 13,
    "color": "black",
    "text": ["Urban areas", "have much more", "concentrated closures", "whilst regional areas", 
  "still have ATMS open", "and new ones", "opening up", "due to ATMS", "being a lifeline", "in those areas"]
  }
}
  ]
}
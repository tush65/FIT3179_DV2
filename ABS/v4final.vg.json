{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "A packed bubble chart.",
  "width": 760,
  "height": 500,
  "padding": {
    "left": 5,
    "right": 5,
    "top": 20,
    "bottom": 0
  },
  "autosize": "none",
  "signals": [
    {
      "name": "cx",
      "update": "250"
    },
    {
      "name": "cy",
      "update": "height / 2"
    },
    {
      "name": "gravityX",
      "value": 0.2
    },
    {
      "name": "gravityY",
      "value": 0.1
    },
    { "name": "arrowAngle", "value": 160 },
{ "name": "arrowLen", "value": 60 },
{ "name": "textDX", "value": 0 }
  ],
  "data": [
    {
      "name": "table",
      "values": [
        {
          "category": "Entertainment",
          "amount": 6013.1,
          "pct": 49.9,
          "type" : "Non-Physical"
        },
        {
          "category": "Clothing",
          "amount": 5698.3,
          "pct": 47.3,
          "type" : "Physical"
        },
        {
          "category": "Event Tickets",
          "amount": 5719.6,
          "pct": 47.5,
          "type" : "Non-Physical"
        },
        {
          "category": "Travel",
          "amount": 6023.7,
          "pct": 50,
          "type" : "Non-Physical"
        },
        {
          "category": "Toys",
          "amount": 3661.7,
          "pct": 30.4,
          "type" : "Physical"
        },
        {
          "category": "Electronics",
          "amount": 3119.2,
          "pct": 25.9,
          "type" : "Physical"
        },
        {
          "category": "Food",
          "amount": 2316,
          "pct": 19.2,
          "type" : "Physical"
        },
        {
          "category": "Health",
          "amount": 1780.4,
          "pct": 14.8,
          "type" : "Physical"
        },
        {
          "category": "Cars",
          "amount": 1342.6,
          "pct": 11.2,
          "type" : "Physical"
        },
        {
          "category": "Gambling",
          "amount": 590.5,
          "pct": 4.9,
          "type" : "Non-Physical"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "size",
      "domain": {
        "data": "table",
        "field": "amount"
      },
      "zero": true,
      "range": [
        0,
        25000
      ]
    },
    {
  "name": "color",
  "type": "ordinal",
  "domain": ["Physical", "Non-Physical"],
  "range": ["#c0392b", "#2e7d32"]
  }
  ],
  "legends": [
  {
    "fill": "color",
    "title": "Item type",
    "orient": "none",
     "legendX": 10,
    "legendY": 10,
    "symbolType": "circle",
    "symbolSize": 150,
    "labelFontSize": 12,
    "titleFontSize": 12
  }
],
  "marks": [
    {
      "name": "nodes",
      "type": "symbol",
      "from": {
        "data": "table"
      },
      "encode": {
        "enter": {
          "fill": {
            "scale": "color",
            "field": "type"
          },
          "xfocus": {
            "signal": "cx"
          },
          "yfocus": {
            "signal": "cy"
          }
        },
        "update": {
          "size": {
            "signal": "datum.amount",
            "scale": "size"
          },
          "stroke": {
            "value": "white"
          },
          "strokeWidth": {
            "value": 1
          },
          "tooltip": {
            "signal": "datum"
          }
        }
      },
      "transform": [
        {
          "type": "force",
          "iterations": 100,
          "static": false,
          "forces": [
            {
              "force": "collide",
              "iterations": 2,
              "radius": {
                "expr": "sqrt(datum.size)/2"
              }
            },
            {
              "force": "center",
              "x": {
                "signal": "cx"
              },
              "y": {
                "signal": "cy"
              }
            },
            {
              "force": "x",
              "x": "xfocus",
              "strength": {
                "signal": "gravityX"
              }
            },
            {
              "force": "y",
              "y": "yfocus",
              "strength": {
                "signal": "gravityY"
              }
            }
          ]
        }
      ]
    },
    {
  "type": "rule",
  "from": { "data": "nodes" },
  "encode": {
    "update": {
      "x": { "signal": "datum.x + cos(arrowAngle * PI / 180) * sqrt(datum.size) / 2" },
      "y": { "signal": "datum.y + sin(arrowAngle * PI / 180) * sqrt(datum.size) / 2" },
      "x2": { "signal": "datum.x + cos(arrowAngle * PI / 180) * (sqrt(datum.size) / 2 + arrowLen)" },
      "y2": { "signal": "datum.y + sin(arrowAngle * PI / 180) * (sqrt(datum.size) / 2 + arrowLen)" },
      "stroke": { "value": "#555" },
      "strokeWidth": { "value": 1.5 },
      "opacity": { "signal": "datum.datum.category === 'Clothing' ? 1 : 0" }
    }
  }
},
{
  "type": "symbol",
  "from": { "data": "nodes" },
  "encode": {
    "update": {
      "x": { "signal": "datum.x + cos(arrowAngle * PI / 180) * (sqrt(datum.size) / 2 + arrowLen)" },
      "y": { "signal": "datum.y + sin(arrowAngle * PI / 180) * (sqrt(datum.size) / 2 + arrowLen)" },
      "shape": { "value": "triangle-right" },
      "angle": { "signal": "arrowAngle" },
      "size": { "value": 60 },
      "fill": { "value": "#555" },
      "opacity": { "signal": "datum.datum.category === 'Clothing' ? 1 : 0" }
    }
  }
},
{
  "type": "text",
  "from": { "data": "nodes" },
  "encode": {
    "update": {
      "x": { "signal": "datum.x + cos(arrowAngle * PI / 180) * (sqrt(datum.size) / 2 + arrowLen) + textDX" },
      "y": { "signal": "datum.y + sin(arrowAngle * PI / 180) * (sqrt(datum.size) / 2 + arrowLen) + 12" },
      "align": { "value": "center" },
      "baseline": { "value": "top" },
      "fontSize": { "value": 12 },
      "fontStyle": { "value": "italic" },
      "fill": { "value": "black" },
      "text": { "value": ["Clothing is physical,", "yet nearly half", "still buy it online.", "This is an", "exception to", "other items", "like cars", "and electronics."] },
      "opacity": { "signal": "datum.datum.category === 'Clothing' ? 1 : 0" }
    }
  }
},
    {
      "type": "text",
      "from": {
        "data": "nodes"
      },
      "encode": {
        "enter": {
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
             "value": "#ffffff"
          },
          "text": {
            "field": "datum.category"
          }
        },
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "fontSize": {
            "signal": "min(15, max(9, sqrt(datum.size) / 4.5))"
          },
          "dy": {
            "signal": "-0.7 * min(15, max(9, sqrt(datum.size) / 4.5))"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "nodes"
      },
      "encode": {
        "enter": {
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "fill": {
            "value": "#ffffff"
          },
          "text": {
            "signal": "datum.datum.pct + '%'"
          }
        },
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "dy": {
            "signal": "0.8 * min(15, max(9, sqrt(datum.size) / 4.5))"
          },
          "fontSize": {
            "signal": "min(15, max(9, sqrt(datum.size) / 4.5))"
          }
        }
      }
    }
  ]
}
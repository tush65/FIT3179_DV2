{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Internet Activities Across Age Groups (%) (2016-2017)",
    "fontSize": 16,
    "anchor": "middle"
  },
  "width": "container",
  "height": 550,
  "data": { "url": "ABS/technology_usage_processed.csv" },
  "layer": [
    {
      "mark": "rect",
      "encoding": {
         "x": {
          "field": "Age Group",
          "type": "ordinal",
          "title": "Age Group",
          "sort": ["15–17", "18–24", "25–34", "35–44", "45–54", "55–64", "65 or over"],
          "axis": { "labelAngle": 0 }
        },
         "y": {
          "field": "Activity",
          "type": "nominal",
          "title": "Activity Category"
        },
        "color": {
          "field": "Percentage",
          "type": "quantitative",
          "title": "Usage (%)",
          "scale": {
            "scheme": "greens",
            "domain": [0, 100]
          },
          "legend": {
  "orient": "right",
  "title": [" ", " ", " ", " ", "Usage (%)"]
}
        },
        "tooltip": [
          { "field": "Age Group", "type": "nominal" },
          { "field": "Activity", "type": "nominal" },
          { "field": "Percentage", "type": "quantitative", "format": ".1f" }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "baseline": "middle"
      },
      "encoding": {
        "x": {
          "field": "Age Group",
          "type": "ordinal",
          "sort": ["15–17", "18–24", "25–34", "35–44", "45–54", "55–64", "65 or over"]
        },
        "y": {
          "field": "Activity",
          "type": "nominal"
        },
        "text": { "field": "Percentage", "type": "quantitative", "format": ".1f" },
        "color": {
          "condition": {
            "test": "datum.Percentage > 60",
            "value": "white"
          },
          "value": "black"
        }
      }
    },
     {
      "data": { "values": [{}] },
      "mark": {
        "type": "text",
        "x": "width",
        "y": 350,
        "dx": 20,
        "align": "left",
        "baseline": "top",
        "fontSize": 11,

        "color": "black",
        "text": ["Teens lead on" , "social and study," , "but bank least:",  "access, not ability"  , "drives the gap.",
          "Health is the", "one activity" , "no age group",  "fully embraces:", "a gap for",  "digital growth."]
      }
    },
    {
      "data": { "values": [{}] },
      "mark": {
        "type": "text",
        "x": "width",
        "y": "height",
        "dy": 55,
        "align": "right",
        "baseline": "top",
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "black",
        "text": "Source: ABS, Household Use of Information Technology, 2016–17"
      }
    }
  ]
}

     
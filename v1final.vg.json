{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 450,
  "title": {
    "text": "Global Internet Adoption Rate",
    "subtitle": "Percentage of population using the internet across tracked nations"
  },
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "ne_110m_admin_0_countries.json",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "transform": [
        {
          "lookup": "properties.ISO_A3",
          "from": {
            "data": {
              "url": "World Bank/v2.csv",
              "format": {"type": "csv"}
            },
            "key": "Country Code",
            "fields": ["Adoption_Rate"]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "Adoption_Rate",
          "type": "quantitative",
          "scale": {
            "scheme": "greens",
            "domain": [0, 100]
          },
          "legend": {
            "title": "Adoption Rate (%)"
          }
        },
        "tooltip": [
          {"field": "properties.NAME", "type": "nominal", "title": "Country"},
          {"field": "properties.ISO_A3", "type": "nominal", "title": "Code"},
          {"field": "Adoption_Rate", "type": "quantitative", "format": ".1f", "title": "Adoption (%)"}
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/7_others/oceans.topojson",
        "format": {"type": "topojson", "feature": "oceans"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "skyblue"
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/WorldMapWithGraticules.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_graticules_30"}
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "lightgray",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "values": [
          {"longitude": 135, "latitude": -25}
        ]
      },
      "mark": {
        "type": "text",
        "text": ["Australia has one of the highest", "adoption rates in the world,", "at 96.1%"],
        "align": "center",
        "dx": -15,
        "dy": 50,
        "fontWeight": "bold",
        "fontSize": 11,
        "fill": "black"
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"}
      }
    }
  ]
}
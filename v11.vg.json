{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "What Australians Do On Social Media",
    "subtitle": "Share of users who do each activity (people could choose more than one)",
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontStyle": "italic"
  },
  "description": "Share of social media users rating each feature important.",
  "data": {
    "values": [
      {"feature": "Reading private messages", "value": 71},
      {"feature": "Posts of people/topics I follow", "value": 62},
      {"feature": "Posts shared privately with me", "value": 60},
      {"feature": "Reading comments", "value": 42},
      {"feature": "Posts suggested by the platform", "value": 29}
    ]
  },
  "transform": [
    {
      "calculate": "[{'part': 'Used', 'val': datum.value, 'ord': 0}, {'part': 'Rest', 'val': 100 - datum.value, 'ord': 1}]",
      "as": "parts"
    },
    {"flatten": ["parts"]},
    {"calculate": "datum.parts.part", "as": "part"},
    {"calculate": "datum.parts.val", "as": "val"},
    {"calculate": "datum.parts.ord", "as": "ord"}
  ],
  "facet": {
    "field": "feature",
    "type": "nominal",
    "header": {
      "title": null,
      "labelFontSize": 11,
      "labelFontWeight": "bold",
      "labelLimit": 180
    }
  },
  "columns": 3,
  "spec": {
    "width": 120,
    "height": 120,
    "mark": {
      "type": "arc",
      "innerRadius": 35,
      "outerRadius": 55,
      "stroke": "#fff",
      "strokeWidth": 1
    },
    "encoding": {
      "theta": {
        "field": "val",
        "type": "quantitative",
        "stack": true
      },
      "order": {
        "field": "ord",
        "type": "quantitative"
      },
      "color": {
        "field": "part",
        "type": "nominal",
        "scale": {"domain": ["Used", "Rest"],
          "range": ["#3182bd", "#e5e5e5"]
        },
        "legend": null
      },
      "tooltip": [
        {"field": "feature", "type": "nominal", "title": "Activity"},
        {"field": "value", "type": "quantitative", "title": "% of Users"}
      ]
    }
  },
  "resolve": {
    "scale": {
      "color": "shared"
    }
  }
}
{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Australian Everyday Digital Life Profile radar chart",
  "width": 560,
  "height": 600,
  "padding": {"left": 150, "right": 150, "top": 20, "bottom": 50},
  "autosize": {"type": "none", "contains": "padding"},

  "title": {
    "text": "Australian Everyday Digital Life Profile (2016-2017)",
    "subtitle": "Household participation rate (%) across daily digital activities",
    "anchor": "middle",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "color": "#1e293b",
    "subtitleColor": "#64748b",
    "offset": 20
  },

  "signals": [
    {"name": "radius", "value": 176}
  ],

  "data": [
    {
      "name": "table",
      "values": [
        {"key": "Banking", "value": 79.5, "id": 0},
        {"key": "Entertainment", "value": 80.0, "id": 1},
        {"key": "Social Networking", "value": 79.9, "id": 2},
        {"key": "Purchasing Goods or Services", "value": 72.6, "id": 3},
        {"key": "Education", "value": 31.7, "id": 4},
        {"key": "Health Services", "value": 46.1, "id": 5}
      ]
    },
    {
      "name": "rings",
      "values": [{"level": 40}, {"level": 60}, {"level": 80}, {"level": 100}]
    },
    {
      "name": "arrows",
      "values": [
        {"x": -30, "y": -13, "x2": -85, "y2": -13},
    {"x": -58, "y": 29, "x2": -85, "y2": 29},
    {"x": -85, "y": 29, "x2": -85, "y2": -32}
      ]
    },
    {
  "name": "arrowhead",
  "values": [
     {"x": -85, "y": -38}
  ]
}
  ],
  

  "scales": [
    {
      "name": "radial",
      "type": "linear",
      "domain": [20, 100],
      "range": {"signal": "[0, radius]"},
      "zero": false,
      "nice": false
    }
  ],

  "encode": {
    "enter": {
      "x": {"signal": "width / 2"},
      "y": {"signal": "height / 2"}
    }
  },

  "marks": [
    {
      "type": "group",
      "name": "ring-group",
      "zindex": 0,
      "from": {"facet": {"data": "rings", "name": "ringFacet", "groupby": "level"}},
      "marks": [
        {
          "type": "line",
          "from": {"data": "table"},
          "encode": {
            "enter": {
              "interpolate": {"value": "linear-closed"},
              "x": {"signal": "scale('radial', parent.level) * cos(datum.id * PI / 3 - PI / 2)"},
              "y": {"signal": "-scale('radial', parent.level) * sin(datum.id * PI / 3 - PI / 2)"},
              "stroke": {"value": "#e2e8f0"},
              "strokeWidth": {"value": 1}
            }
          }
        }
      ]
    },
    {
      "type": "rule",
      "name": "spokes",
      "from": {"data": "table"},
      "zindex": 0,
      "encode": {
        "enter": {
          "x": {"value": 0},
          "y": {"value": 0},
          "x2": {"signal": "radius * cos(datum.id * PI / 3 - PI / 2)"},
          "y2": {"signal": "-radius * sin(datum.id * PI / 3 - PI / 2)"},
          "stroke": {"value": "#cbd5e1"},
          "strokeWidth": {"value": 1}
        }
      }
    },
    {
      "type": "line",
      "name": "area",
      "from": {"data": "table"},
      "zindex": 1,
      "encode": {
        "enter": {
          "interpolate": {"value": "linear-closed"},
          "x": {"signal": "scale('radial', datum.value) * cos(datum.id * PI / 3 - PI / 2)"},
          "y": {"signal": "-scale('radial', datum.value) * sin(datum.id * PI / 3 - PI / 2)"},
          "fill": {"value": "green"},
          "fillOpacity": {"value": 0.3},
          "stroke": {"value": "green"},
          "strokeWidth": {"value": 2.5}
        }
      }
    },
    {
      "type": "symbol",
      "name": "points",
      "from": {"data": "table"},
      "zindex": 2,
      "encode": {
        "enter": {
          "x": {"signal": "scale('radial', datum.value) * cos(datum.id * PI / 3 - PI / 2)"},
          "y": {"signal": "-scale('radial', datum.value) * sin(datum.id * PI / 3 - PI / 2)"},
          "size": {"value": 120},
          "fill": {"value": "green"},
          "cursor": {"value": "pointer"},
          "tooltip": {
            "signal": "{'Activity': datum.key, 'Participation Rate (%)': format(datum.value, '.1f')}"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "value-labels",
      "from": {"data": "table"},
      "zindex": 2,
      "encode": {
        "enter": {
          "x": {"signal": "(scale('radial', datum.value) + 25) * cos(datum.id * PI / 3 - PI / 2)"},
          "y": {"signal": "-(scale('radial', datum.value) + 25) * sin(datum.id * PI / 3 - PI / 2)"},
          "text": {"signal": "datum.value + '%'"},
          "align": {"value": "center"},
          "baseline": {"value": "middle"},
          "fontWeight": {"value": "bold"},
          "fontSize": {"value": 11},
          "fill": {"value": "green"}
        }
      }
    },
    {
      "type": "text",
      "name": "category-labels",
      "from": {"data": "table"},
      "zindex": 2,
      "encode": {
        "enter": {
          "x": {"signal": "(radius + 24) * cos(datum.id * PI / 3 - PI / 2)"},
          "y": {"signal": "-(radius + 24) * sin(datum.id * PI / 3 - PI / 2)"},
          "text": {"field": "key"},
          "align": [
            {"test": "abs(cos(datum.id * PI / 3 - PI / 2)) < 0.1", "value": "center"},
            {"test": "cos(datum.id * PI / 3 - PI / 2) > 0", "value": "left"},
            {"value": "right"}
          ],
          "baseline": [
            {"test": "sin(datum.id * PI / 3 - PI / 2) < -0.9", "value": "top"},
            {"test": "sin(datum.id * PI / 3 - PI / 2) > 0.9", "value": "bottom"},
            {"value": "middle"}
          ],
          "fontWeight": {"value": "bold"},
          "fontSize": {"value": 12},
          "fill": {"value": "#1e293b"}
        }
      }
    },
      {
      "type": "text",
      "name": "annotation-paragraph",
      "zindex": 3,
      "encode": {
        "enter": {
         "x": {"value": -85},
          "y": {"value": -100},
          "text": {
            "value": [
             "These sectors",
             "are the outliers",
             "since these fields",
             "are more traditional",
             "on in person components"
              
            ]
          },
          "align": {"value": "center"},
          "baseline": {"value": "bottom"},
          "fontSize": {"value": 11},
          "lineHeight": {"value": 14},
          "fill": {"value": "black"}
        }
      }
    },
    {
      "type": "rule",
      "name": "arrow-lines",
      "from": {"data": "arrows"},
      "zindex": 3,
      "encode": {
        "enter": {
          "x": {"field": "x"},
          "y": {"field": "y"},
          "x2": {"field": "x2"},
          "y2": {"field": "y2"},
          "stroke": {"value": "#475569"},
          "strokeWidth": {"value": 1.5}
        }
      }
    },
    {
      "type": "symbol",
      "name": "arrow-heads",
      "from": {"data": "arrowhead"},
      "zindex": 3,
      "encode": {
        "enter": {
          "x": {"field": "x"},
          "y": {"field": "y"},
          "shape": {"value": "triangle-up"},
          "size": {"value": 70},
          "fill": {"value": "#475569"}
        }
      }
    }
  ]
}